# Next.js (Vercel). `npx convex dev` writes the first three for local work.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Convex deployment env (set with `npx convex env set NAME value`, never in git):
#   BETTER_AUTH_SECRET   openssl rand -base64 32
#   SITE_URL             the Next.js origin, e.g. https://task-control.example.com
#   SUPER_ADMIN_EMAILS   comma-separated; the only people who can create accounts and workspaces
